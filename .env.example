# Django settings
SECRET_KEY=your-secret-key
DEBUG=True
BASE_URL=http://localhost:8000

# PostgreSQL database settings for the Django app
DB_NAME=acvs
DB_USER=acvs_user
DB_PASSWORD=acvs_pass
DB_HOST=db
DB_PORT=5432

# Blockchain settings (optional but required for credential issuance)
BLOCKCHAIN_RPC_URL=https://your-ethereum-node.example
BLOCKCHAIN_ACCOUNT=0xYourAccountAddress
BLOCKCHAIN_PRIVATE_KEY=your-private-key

# Email settings (required by Django email configuration)
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
